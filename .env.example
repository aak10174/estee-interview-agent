# Copy this file to .env and fill in the three required values.
# Never commit .env — it is gitignored.

# --- Required ---
ANTHROPIC_API_KEY=sk-ant-...
TELEGRAM_BOT_TOKEN=123456:ABC-your-token-from-BotFather
# The chat that receives the digest. Get it by messaging your bot, then running:
#   make chatid                              (macOS/Linux)
#   .\.venv\Scripts\python.exe src\telegram.py   (Windows)
TELEGRAM_CHAT_ID=

# --- Optional ---
# Leave these out entirely unless you mean to change a model. The defaults in
# src/config.py are already correct, and a mistyped name fails at runtime with
# a 404 ("model: claude-opus") rather than being caught here.
#
# ANTHROPIC_MODEL=claude-sonnet-5            # per-interview extraction
# ANTHROPIC_SYNTHESIS_MODEL=claude-opus-5    # cross-interview synthesis
# ANTHROPIC_DIGEST_MODEL=claude-haiku-4-5    # the Telegram digest
